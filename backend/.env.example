# ---------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------

# Replace this with a strong random value in production.
DJANGO_SECRET_KEY=change-me-in-production

# Use true locally and false in production.
DJANGO_DEBUG=true

# Comma-separated hostnames without https://
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Next.js frontend URL
FRONTEND_URL=http://localhost:3000

# Comma-separated frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Comma-separated trusted origins used by Django CSRF protection
CSRF_TRUSTED_ORIGINS=http://localhost:3000


# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------

# Leave empty locally to use SQLite.
# Use a pooled Neon PostgreSQL URL in production.
DATABASE_URL=


# ---------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------

# mock = deterministic local responses without an API key
# live = call the configured OpenAI-compatible provider
AI_MODE=mock

AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=

AI_MODEL=openai/gpt-oss-20b
AI_FALLBACK_MODEL=openai/gpt-oss-120b
AI_TIMEOUT_SECONDS=45


# ---------------------------------------------------------------------
# Demo account
# ---------------------------------------------------------------------

# Created or updated by:
# python manage.py seed_demo
#
# Do not use a Django superuser email for this account.
DEMO_EMAIL=demo@triageiq.dev

# Replace this before deployment.
# Do not commit the real production password.
DEMO_PASSWORD=change-demo-password-before-deployment

DEMO_USERNAME=triageiq-demo

# Supported safe roles:
# viewer, incident_manager, reviewer
#
# Recommended value for a public portfolio deployment:
DEMO_ROLE=viewer

# Keep false so the password is not printed in deployment logs.
DEMO_PRINT_PASSWORD=false


# ---------------------------------------------------------------------
# Temporary incident source files
# ---------------------------------------------------------------------

# Use local during development.
# Use s3 in production.
TEMP_UPLOAD_STORAGE_MODE=local

TEMP_UPLOAD_LOCAL_ROOT=.temporary-uploads

# Keep uploads at or below 4 MB.
TEMP_UPLOAD_MAX_MB=4

TEMP_UPLOAD_MAX_PDF_PAGES=25
TEMP_UPLOAD_MAX_LOG_LINES=5000
TEMP_UPLOAD_MAX_EXTRACTED_CHARS=15000

# Maximum expired files processed by one scheduled cleanup run.
TEMP_UPLOAD_CLEANUP_BATCH_SIZE=100

# Authentication secret for the scheduled cleanup endpoint.
# Generate a strong random value for production.
# Never commit the real production secret.
CRON_SECRET=replace-with-a-strong-random-value

# ---------------------------------------------------------------------
# Private S3-compatible object storage
# ---------------------------------------------------------------------

# Required only when:
# TEMP_UPLOAD_STORAGE_MODE=s3
#
# Supabase endpoint format:
# https://<project-ref>.storage.supabase.co/storage/v1/s3
#
# Never commit real access credentials to GitHub.

S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=triageiq-temp-uploads
S3_REGION=ap-southeast-2
S3_FORCE_PATH_STYLE=true