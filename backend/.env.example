# ---------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------

# Replace this with a strong random value in production.
DJANGO_SECRET_KEY=change-me-in-production

# Use true locally and false in production.
DJANGO_DEBUG=true

# Comma-separated hostnames without https://
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Next.js frontend URL
FRONTEND_URL=http://localhost:3000

# Comma-separated frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Comma-separated trusted origins used by Django CSRF protection
CSRF_TRUSTED_ORIGINS=http://localhost:3000


# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------

# Leave empty locally to use SQLite.
# Use a pooled Neon PostgreSQL URL in production.
DATABASE_URL=


# ---------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------

# mock = deterministic local responses without an API key
# live = call the configured OpenAI-compatible provider
AI_MODE=mock

AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=

AI_MODEL=openai/gpt-oss-20b
AI_FALLBACK_MODEL=openai/gpt-oss-120b
AI_TIMEOUT_SECONDS=45


# ---------------------------------------------------------------------
# Demo account
# ---------------------------------------------------------------------

# Created by:
# python manage.py seed_demo
#
# Change the password before any public deployment or configure a
# restricted viewer account instead.
DEMO_EMAIL=demo@triageiq.dev
DEMO_PASSWORD=DemoPass123!


# ---------------------------------------------------------------------
# Temporary incident source files
# ---------------------------------------------------------------------

# Use local during development.
# Use r2 in production.
TEMP_UPLOAD_STORAGE_MODE=local

TEMP_UPLOAD_LOCAL_ROOT=.temporary-uploads

# Vercel request bodies have a limited size, so keep uploads at 4 MB.
TEMP_UPLOAD_MAX_MB=4

TEMP_UPLOAD_MAX_PDF_PAGES=25
TEMP_UPLOAD_MAX_LOG_LINES=5000
TEMP_UPLOAD_MAX_EXTRACTED_CHARS=15000


# ---------------------------------------------------------------------
# Private Cloudflare R2 bucket
# ---------------------------------------------------------------------

# Required only when:
# TEMP_UPLOAD_STORAGE_MODE=r2
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=triageiq-temporary-files
