# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database: omit locally to use SQLite. Use a pooled Neon URL in deployment.
DATABASE_URL=

# AI provider
AI_MODE=mock
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_FALLBACK_MODEL=openai/gpt-oss-120b
AI_TIMEOUT_SECONDS=45

# Demo account created by: python manage.py seed_demo
DEMO_EMAIL=demo@triageiq.dev
DEMO_PASSWORD=DemoPass123!

# Temporary incident source files
# Use local for development. Use r2 in deployment.
TEMP_UPLOAD_STORAGE_MODE=local
TEMP_UPLOAD_LOCAL_ROOT=.temporary-uploads
TEMP_UPLOAD_MAX_MB=4
TEMP_UPLOAD_MAX_PDF_PAGES=25
TEMP_UPLOAD_MAX_LOG_LINES=5000
TEMP_UPLOAD_MAX_EXTRACTED_CHARS=15000

# Private Cloudflare R2 bucket (required when TEMP_UPLOAD_STORAGE_MODE=r2)
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=triageiq-temporary-files
